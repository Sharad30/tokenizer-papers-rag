# Copy to .env (gitignored) and fill in. Keys are read from the environment,
# never from config.yaml. Every key is optional until the phase that uses it.

# Phase 1: Semantic Scholar Graph API. Works without a key at a lower rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Phase 7/8: only if the Anthropic API is chosen as the generator or judge.
ANTHROPIC_API_KEY=
